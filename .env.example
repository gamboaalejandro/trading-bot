# Environment variables for the trading bot. NAMES ONLY: never put values here.
# Export them in the machine's environment (recommended) or in a git-ignored
# .env file loaded by your shell:  set -a; source .env; set +a
# core/secrets.py reads environment variables only, never versioned files.
# Keys: no withdrawal permission, IP whitelist, one pair per environment.

# --- Spot Demo (https://demo.binance.com -> API management) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Optional spot base URL override (default https://demo-api.binance.com)
BINANCE_SPOT_BASE_URL=
# Legacy spot override used by core/binance_client.py
BINANCE_TESTNET_URL=

# --- USDT-M Futures Testnet ---
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
# Optional futures base URL (default https://testnet.binancefuture.com)
BINANCE_FUTURES_BASE_URL=

# --- Production (only after the gate, PLAN §7) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Legacy name read by core/config.py (same value as BINANCE_API_SECRET)
BINANCE_SECRET=
# Required for any order against production: I_UNDERSTAND
LIVE_TRADING_CONFIRM=

# --- Execution mode: dry_run (default), spot_demo, futures_testnet, live ---
TRADING_MODE=
BINANCE_MODE=

# --- Misc ---
ENV=
REDIS_URL=
ZMQ_FEED_HANDLER_URL=
ZMQ_RL_AGENT_URL=

# --- Legacy risk settings (core/config.py) ---
MAX_DAILY_DRAWDOWN=
MAX_RISK_PER_TRADE=
KELLY_FRACTION=
DEFAULT_LEVERAGE=
DEFAULT_SYMBOL=
DEFAULT_TIMEFRAME=

# --- Execution safety (core/config.py) ---
# TRADING_MODE defaults to dry_run; LIVE_TRADING_CONFIRM must be exactly
# I_UNDERSTAND only for TRADING_MODE=live.
# 1m profiles (timeframe <= 15m) and the legacy multi_symbol_engine (any
# timeframe) are forced to dry_run unless ALLOW_1M_LIVE is true (default false).
ALLOW_1M_LIVE=
