# Environment Variables for QuantMind-Alpha

# ============================================
# BINANCE API CONFIGURATION (DEMO MODE)
# ============================================
# Get Demo Mode API Keys from: https://demo.binance.com/en/my/settings/api-management
# Note: You must log into your regular Binance account first
BINANCE_API_KEY=your_demo_api_key_here
BINANCE_SECRET=your_demo_secret_here

# API Mode: 'demo' or 'production'
# IMPORTANT: Keep as 'demo' for testing with virtual funds
BINANCE_MODE=demo

# Environment
ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# ZeroMQ
ZMQ_FEED_HANDLER_URL=tcp://127.0.0.1:5555
ZMQ_RL_AGENT_URL=tcp://127.0.0.1:5556

# Risk Management
MAX_DAILY_DRAWDOWN=0.05
MAX_RISK_PER_TRADE=0.02
KELLY_FRACTION=0.25
DEFAULT_LEVERAGE=1

# Trading
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1m

# Execution mode: dry_run (default) | spot_demo | futures_testnet | live
TRADING_MODE=dry_run
# Required (exact value I_UNDERSTAND) only for TRADING_MODE=live
LIVE_TRADING_CONFIRM=
# 1m profiles (timeframe <= 15m) and the legacy multi_symbol_engine (any
# timeframe) are forced to dry_run unless this is true
ALLOW_1M_LIVE=false
